rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny catch-all rule
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().role == 'superadmin';
    }

    function isClinicalAdmin() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (getUserData().role == 'admin' || getUserData().role == 'superadmin');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isClinicalAdmin();
    }

    // Patients Collection - linked to Clinical Admin
    match /patients/{patientId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isClinicalAdmin();
    }

    // Caregivers Collection
    match /caregivers/{caregiverId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isClinicalAdmin();
    }

    // Doctors Collection
    match /doctors/{doctorId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isClinicalAdmin();
    }

    // Medications Collection
    match /medications/{medicationId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isClinicalAdmin();
    }

    // Medical Records Collection
    match /medical_records/{recordId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isClinicalAdmin();
    }

    // Medical Appointments and Exams Collection
    match /medical_appointments/{appointmentId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isClinicalAdmin();
    }

    // Schedules Collection
    match /schedules/{scheduleId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isClinicalAdmin();
    }

    // Permanent Audit History Collection - read/create only, NEVER update or delete
    match /history/{historyId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // Settings Collection
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isClinicalAdmin();
    }
  }
}
